@model Library_Management.Models.AddBookCopyViewModel

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="bi bi-plus-circle me-2"></i>
        Add Copy for "@Model.BookTitle"
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="addBookCopyForm" asp-action="AddBookCopy" method="post">
    <div class="modal-body">
        <input type="hidden" asp-for="BookId" />
        <input type="hidden" asp-for="BookTitle" />
        
        <!-- Book Information Display -->
        <div class="alert alert-info border-0 mb-4">
            <div class="d-flex align-items-center">
                <i class="bi bi-info-circle-fill me-2"></i>
                <div>
                    <strong>Adding copy for:</strong> @Model.BookTitle
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Cover Image URL -->
            <div class="col-12">
                <label asp-for="CoverImageUrl" class="form-label">
                    <i class="bi bi-image me-1"></i>
                    @Html.DisplayNameFor(m => m.CoverImageUrl)
                </label>
                <input asp-for="CoverImageUrl" class="form-control" placeholder="Enter cover image URL (optional)" />
                <div class="form-text">
                    <i class="bi bi-lightbulb me-1"></i>
                    Leave empty to use the existing book cover image
                </div>
                <span asp-validation-for="CoverImageUrl" class="text-danger small"></span>
            </div>

            <!-- Condition -->
            <div class="col-md-6">
                <label asp-for="Condition" class="form-label">
                    <i class="bi bi-clipboard-check me-1"></i>
                    @Html.DisplayNameFor(m => m.Condition) *
                </label>
                <select asp-for="Condition" class="form-select">
                    <option value="New">New</option>
                    <option value="Like New">Like New</option>
                    <option value="Very Good">Very Good</option>
                    <option value="Good">Good</option>
                    <option value="Fair">Fair</option>
                    <option value="Poor">Poor</option>
                </select>
                <span asp-validation-for="Condition" class="text-danger small"></span>
            </div>

            <!-- Source -->
            <div class="col-md-6">
                <label asp-for="Source" class="form-label">
                    <i class="bi bi-tag me-1"></i>
                    @Html.DisplayNameFor(m => m.Source) *
                </label>
                <select asp-for="Source" class="form-select">
                    <option value="Purchase">Purchase</option>
                    <option value="Donation">Donation</option>
                    <option value="Gift">Gift</option>
                    <option value="Library Transfer">Library Transfer</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Source" class="text-danger small"></span>
            </div>
        </div>

        <!-- Preview Section -->
        <div class="mt-4">
            <h6 class="fw-semibold mb-3">
                <i class="bi bi-eye me-1"></i>
                Copy Preview
            </h6>
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="copy-preview-image bg-secondary rounded d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 80px; color: white;">
                                <i class="bi bi-book"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h6 class="mb-1">@Model.BookTitle</h6>
                            <div class="d-flex gap-3">
                                <small class="text-muted">
                                    <i class="bi bi-clipboard-check me-1"></i>
                                    <span id="conditionPreview">@Model.Condition</span>
                                </small>
                                <small class="text-muted">
                                    <i class="bi bi-tag me-1"></i>
                                    <span id="sourcePreview">@Model.Source</span>
                                </small>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-calendar-plus me-1"></i>
                                Added: @DateTime.Now.ToString("MMM dd, yyyy")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i>
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Copy
        </button>
    </div>
</form>

<script>
    // Update preview when form values change
    document.addEventListener('DOMContentLoaded', function() {
        const conditionSelect = document.querySelector('select[name="Condition"]');
        const sourceSelect = document.querySelector('select[name="Source"]');
        const coverImageInput = document.querySelector('input[name="CoverImageUrl"]');
        const previewImage = document.querySelector('.copy-preview-image');
        
        // Update condition preview
        conditionSelect?.addEventListener('change', function() {
            document.getElementById('conditionPreview').textContent = this.value;
        });
        
        // Update source preview
        sourceSelect?.addEventListener('change', function() {
            document.getElementById('sourcePreview').textContent = this.value;
        });
        
        // Update image preview
        coverImageInput?.addEventListener('input', function() {
            if (this.value.trim()) {
                previewImage.innerHTML = `<img src="${this.value}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;" onerror="this.parentElement.innerHTML='<i class=\\'bi bi-exclamation-triangle\\'></i>'" />`;
            } else {
                previewImage.innerHTML = '<i class="bi bi-book"></i>';
            }
        });
    });
</script>

<style>
    .copy-preview-image {
        transition: all 0.3s ease;
    }
    
    .copy-preview-image:hover {
        transform: scale(1.05);
    }
    
    .form-select:focus,
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }
</style>
