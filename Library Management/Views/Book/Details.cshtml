@model Library_Management.Models.BookListViewModel

<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">@Model.Title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    <div class="row g-4">
        <!-- Cover Image -->
        <div class="col-md-4 text-center">
            <img src="@Model.CoverImageUrl"
                 class="img-fluid rounded shadow-sm"
                 alt="@Model.Title"
                 style="max-height: 300px; object-fit: cover;">
        </div>

        <!-- Details -->
        <div class="col-md-8">
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-semibold">@Html.DisplayNameFor(m => m.ISBN)</dt>
                <dd class="col-sm-8">@Model.ISBN</dd>

                <dt class="col-sm-4 fw-semibold">@Html.DisplayNameFor(m => m.AuthorName)</dt>
                <dd class="col-sm-8 d-flex align-items-center">
                    @Model.AuthorName
                    @if (!string.IsNullOrEmpty(Model.AuthorProfileImageUrl))
                    {
                        <img src="@Model.AuthorProfileImageUrl"
                             class="rounded-circle ms-2"
                             style="width: 30px; height: 30px; object-fit: cover;"
                             alt="Author Profile">
                    }
                </dd>

                <dt class="col-sm-4 fw-semibold">@Html.DisplayNameFor(m => m.Genre)</dt>
                <dd class="col-sm-8">@Model.Genre</dd>

                <dt class="col-sm-4 fw-semibold">@Html.DisplayNameFor(m => m.PublishedDate)</dt>
                <dd class="col-sm-8">@Model.PublishedDate?.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-4 fw-semibold">Available Copies</dt>
                <dd class="col-sm-8">@Model.AvailableCopies / @Model.TotalCopies</dd>
            </dl>

            <hr />

            <h6 class="fw-semibold">@Html.DisplayNameFor(m => m.Description)</h6>
            <p class="mb-0">@Model.Description</p>
        </div>
    </div>
</div>

<div class="modal-footer">
    <a asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left"></i> Close
    </a>

    <!-- Add Copy Modal Button -->
    <button type="button" class="btn btn-success" onclick="openAddCopyModal('@Model.BookId')">
        <i class="bi bi-plus-circle"></i> Add Copy
    </button>

    <!-- Quick Add Copy Form (Simple) -->
    <form asp-action="AddCopy" asp-controller="Book" method="post" class="d-inline">
        <input type="hidden" name="id" value="@Model.BookId" />
        <button type="submit" class="btn btn-outline-success" title="Quick add with default settings">
            <i class="bi bi-plus-square"></i> Quick Add
        </button>
    </form>
</div>

<!-- Book Copies Section - Part 2: Pullout Functionality -->
<div class="mt-4">
    <h6 class="fw-semibold mb-3">
        <i class="bi bi-collection me-1"></i>
        Book Copies (@Model.TotalCopies total, @Model.AvailableCopies available)
    </h6>
    
    <div id="bookCopiesContainer">
        <!-- This will be populated with book copies via JavaScript -->
        <div class="text-center py-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading copies...</span>
            </div>
        </div>
    </div>
</div>

<script>
    // Add Copy Modal Function
    function openAddCopyModal(bookId) {
        fetch(`/Book/AddCopyModal?id=${encodeURIComponent(bookId)}`)
            .then(response => response.text())
            .then(html => {
                // Create a new modal for add copy to avoid conflicts
                let addCopyModal = document.getElementById('addCopyModal');
                if (!addCopyModal) {
                    addCopyModal = document.createElement('div');
                    addCopyModal.className = 'modal fade';
                    addCopyModal.id = 'addCopyModal';
                    addCopyModal.setAttribute('tabindex', '-1');
                    addCopyModal.innerHTML = `
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content"></div>
                        </div>
                    `;
                    document.body.appendChild(addCopyModal);
                }
                
                addCopyModal.querySelector('.modal-content').innerHTML = html;
                new bootstrap.Modal(addCopyModal).show();
            })
            .catch(error => {
                alert('Error loading Add Copy modal: ' + error.message);
            });
    }

    // Load book copies on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadBookCopies('@Model.BookId');
    });

    // Function to load book copies
    function loadBookCopies(bookId) {
        // Simulate API call - in a real app, you'd fetch from server
        // For now, we'll create a simple display based on available data
        const container = document.getElementById('bookCopiesContainer');
        const totalCopies = @Model.TotalCopies;
        const availableCopies = @Model.AvailableCopies;
        
        if (totalCopies === 0) {
            container.innerHTML = `
                <div class="text-center py-4">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                    <p class="text-muted mt-2">No copies available</p>
                    <button class="btn btn-primary btn-sm" onclick="openAddCopyModal('${bookId}')">
                        <i class="bi bi-plus-circle me-1"></i>Add First Copy
                    </button>
                </div>
            `;
            return;
        }

        let copiesHtml = '<div class="row g-3">';
        
        // Generate copy cards (simplified for demo)
        for (let i = 1; i <= totalCopies; i++) {
            const isAvailable = i <= availableCopies;
            const copyId = 'copy-' + i; // Simplified ID for demo
            
            copiesHtml += `
                <div class="col-md-6 col-lg-4">
                    <div class="card copy-card ${isAvailable ? 'border-success' : 'border-warning'} h-100">
                        <div class="card-header bg-transparent d-flex justify-content-between align-items-center py-2">
                            <small class="fw-semibold">Copy #${i}</small>
                            <span class="badge ${isAvailable ? 'bg-success' : 'bg-warning text-dark'}">
                                ${isAvailable ? 'Available' : 'Pulled Out'}
                            </span>
                        </div>
                        <div class="card-body py-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-clipboard-check me-2 text-muted"></i>
                                <small><strong>Condition:</strong> ${i <= 2 ? 'New' : i <= 4 ? 'Good' : 'Fair'}</small>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-tag me-2 text-muted"></i>
                                <small><strong>Source:</strong> ${i % 2 === 0 ? 'Purchase' : 'Donation'}</small>
                            </div>
                            <div class="d-flex align-items-center">
                                <i class="bi bi-calendar-plus me-2 text-muted"></i>
                                <small><strong>Added:</strong> ${new Date(Date.now() - (i * 30 * 24 * 60 * 60 * 1000)).toLocaleDateString()}</small>
                            </div>
                            ${!isAvailable ? `
                                <div class="mt-2 p-2 bg-warning bg-opacity-10 rounded">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-exclamation-triangle me-2 text-warning"></i>
                                        <small><strong>Reason:</strong> ${i % 3 === 0 ? 'Damaged' : i % 3 === 1 ? 'Lost' : 'Maintenance'}</small>
                                    </div>
                                    <small class="text-muted d-block mt-1">
                                        <i class="bi bi-calendar-x me-1"></i>
                                        Pulled: ${new Date(Date.now() - (Math.random() * 10 * 24 * 60 * 60 * 1000)).toLocaleDateString()}
                                    </small>
                                </div>
                            ` : ''}
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            ${isAvailable ? `
                                <button class="btn btn-warning btn-sm w-100" onclick="openPulloutModal('${copyId}')">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Pull Out
                                </button>
                            ` : `
                                <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                    <i class="bi bi-dash-circle me-1"></i>Already Pulled Out
                                </button>
                            `}
                        </div>
                    </div>
                </div>
            `;
        }
        
        copiesHtml += '</div>';
        container.innerHTML = copiesHtml;
    }

    // Function to open pullout modal
    function openPulloutModal(copyId) {
        // For demo purposes, we'll use a generated GUID
        const demoGuid = generateGuid();
        
        fetch(`/Book/PulloutModal?copyId=${demoGuid}`)
            .then(response => response.text())
            .then(html => {
                let pulloutModal = document.getElementById('pulloutModal');
                if (!pulloutModal) {
                    pulloutModal = document.createElement('div');
                    pulloutModal.className = 'modal fade';
                    pulloutModal.id = 'pulloutModal';
                    pulloutModal.setAttribute('tabindex', '-1');
                    pulloutModal.innerHTML = `
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content"></div>
                        </div>
                    `;
                    document.body.appendChild(pulloutModal);
                }
                
                pulloutModal.querySelector('.modal-content').innerHTML = html;
                new bootstrap.Modal(pulloutModal).show();
            })
            .catch(error => {
                alert('Error loading Pullout modal: ' + error.message);
            });
    }

    // Helper function to generate demo GUID
    function generateGuid() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    // Handle Add Copy form submission
    document.addEventListener("submit", function (e) {
        const form = e.target;

        if (form.matches("#addBookCopyForm") || form.matches("#pulloutBookCopyForm")) {
            e.preventDefault();
            
            const submitBtn = form.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            
            if (form.matches("#pulloutBookCopyForm")) {
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Pulling Out...';
            } else {
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Adding...';
            }
            submitBtn.disabled = true;

            const formData = new FormData(form);
            fetch(form.action, {
                method: form.method,
                body: new URLSearchParams(formData)
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Failed to add book copy.');
                }
                // Close the modal and reload the page to show updated copy count
                const modal = bootstrap.Modal.getInstance(document.getElementById('addCopyModal'));
                modal.hide();
                
                // Show success message
                const alertHtml = `
                    <div class="alert alert-success alert-dismissible fade show position-fixed" 
                         style="top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Book copy added successfully!
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                document.body.insertAdjacentHTML('beforeend', alertHtml);
                
                // Auto dismiss after 3 seconds and reload
                setTimeout(() => {
                    location.reload();
                }, 1500);
            })
            .catch(error => {
                alert('Error: ' + error.message);
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            });
        }
    });
</script>

<style>
    /* Book Copy Cards Styles - Part 2: Pullout Functionality */
    .copy-card {
        transition: all 0.3s ease;
    }
    
    .copy-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    
    .copy-card.border-success {
        border-color: #198754 !important;
    }
    
    .copy-card.border-warning {
        border-color: #ffc107 !important;
    }
    
    .bg-warning.bg-opacity-10 {
        background-color: rgba(255, 193, 7, 0.1) !important;
    }
</style>
