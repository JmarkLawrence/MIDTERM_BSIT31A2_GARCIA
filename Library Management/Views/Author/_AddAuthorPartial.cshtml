@model Library_Management.Models.AddAuthorViewModel

<!-- Add Author Modal - Part 1: Author Management -->
<div class="modal-header bg-primary text-white">
    <h5 class="modal-title">
        <i class="bi bi-person-plus-fill me-2"></i>
        Add New Author
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="addAuthorForm" asp-action="Add" method="post">
    <div class="modal-body">
        <div class="row g-3">
            <!-- Author Name -->
            <div class="col-12">
                <label asp-for="Name" class="form-label fw-semibold">
                    <i class="bi bi-person me-1 text-primary"></i>
                    @Html.DisplayNameFor(m => m.Name) *
                </label>
                <input asp-for="Name" class="form-control" placeholder="Enter author's full name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Birth Date -->
            <div class="col-md-6">
                <label asp-for="BirthDate" class="form-label fw-semibold">
                    <i class="bi bi-calendar-event me-1 text-primary"></i>
                    @Html.DisplayNameFor(m => m.BirthDate)
                </label>
                <input asp-for="BirthDate" class="form-control" type="date" />
                <span asp-validation-for="BirthDate" class="text-danger small"></span>
            </div>

            <!-- Profile Image URL -->
            <div class="col-md-6">
                <label asp-for="ProfileImageUrl" class="form-label fw-semibold">
                    <i class="bi bi-image me-1 text-primary"></i>
                    @Html.DisplayNameFor(m => m.ProfileImageUrl)
                </label>
                <input asp-for="ProfileImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="ProfileImageUrl" class="text-danger small"></span>
            </div>

            <!-- Biography -->
            <div class="col-12">
                <label asp-for="Biography" class="form-label fw-semibold">
                    <i class="bi bi-journal-text me-1 text-primary"></i>
                    @Html.DisplayNameFor(m => m.Biography)
                </label>
                <textarea asp-for="Biography" class="form-control" rows="4" 
                          placeholder="Enter author's biography, achievements, and background..."></textarea>
                <div class="form-text">
                    <i class="bi bi-info-circle me-1"></i>
                    Maximum 1000 characters
                </div>
                <span asp-validation-for="Biography" class="text-danger small"></span>
            </div>
        </div>

        <!-- Preview Section -->
        <div class="mt-4">
            <h6 class="fw-semibold mb-3">
                <i class="bi bi-eye me-1 text-primary"></i>
                Author Preview
            </h6>
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div id="authorPreviewImage" class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px; color: white;">
                                <i class="bi bi-person"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h6 class="mb-1" id="authorPreviewName">Author Name</h6>
                            <small class="text-muted" id="authorPreviewBirthDate">Birth Date</small>
                            <p class="mb-0 small text-muted mt-1" id="authorPreviewBio">Biography will appear here...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer bg-light border-0">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i>
            Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Author
        </button>
    </div>
</form>

<script>
    // Real-time preview updates
    document.addEventListener('DOMContentLoaded', function() {
        const nameInput = document.querySelector('input[name="Name"]');
        const birthDateInput = document.querySelector('input[name="BirthDate"]');
        const bioInput = document.querySelector('textarea[name="Biography"]');
        const imageInput = document.querySelector('input[name="ProfileImageUrl"]');
        
        const previewName = document.getElementById('authorPreviewName');
        const previewBirthDate = document.getElementById('authorPreviewBirthDate');
        const previewBio = document.getElementById('authorPreviewBio');
        const previewImage = document.getElementById('authorPreviewImage');
        
        // Update name preview
        nameInput?.addEventListener('input', function() {
            previewName.textContent = this.value || 'Author Name';
        });
        
        // Update birth date preview
        birthDateInput?.addEventListener('input', function() {
            if (this.value) {
                const date = new Date(this.value);
                previewBirthDate.textContent = `Born ${date.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                })}`;
            } else {
                previewBirthDate.textContent = 'Birth Date';
            }
        });
        
        // Update biography preview
        bioInput?.addEventListener('input', function() {
            const text = this.value || 'Biography will appear here...';
            previewBio.textContent = text.length > 100 ? text.substring(0, 100) + '...' : text;
        });
        
        // Update image preview
        imageInput?.addEventListener('input', function() {
            if (this.value.trim()) {
                previewImage.innerHTML = `<img src="${this.value}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" onerror="this.parentElement.innerHTML='<i class=\\'bi bi-exclamation-triangle\\'></i>'" />`;
            } else {
                previewImage.innerHTML = '<i class="bi bi-person"></i>';
            }
        });
    });
</script>

<style>
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }
    
    #authorPreviewImage {
        transition: all 0.3s ease;
    }
    
    #authorPreviewImage:hover {
        transform: scale(1.05);
    }
</style>
