@model IEnumerable<Library_Management.Models.AuthorListViewModel>

@{
    ViewData["Title"] = "Authors";
}

<!-- Author Management Index Page - Part 1 -->
<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-2 fw-bold text-primary">
                        <i class="bi bi-people-fill me-2"></i>
                        Authors Management
                    </h1>
                    <p class="text-muted mb-0">Manage authors and view their book collections</p>
                </div>
                <div class="d-flex gap-2">
                    <!-- Add Author Button -->
                    <button class="btn btn-primary" onclick="openAddAuthorModal()">
                        <i class="bi bi-plus-circle me-2"></i>
                        Add New Author
                    </button>
                    <!-- Archive Link -->
                    <a asp-action="Archive" class="btn btn-outline-secondary">
                        <i class="bi bi-archive me-2"></i>
                        View Archive
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-people text-primary" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0 fw-bold">@Model.Count()</h3>
                    <small class="text-muted">Total Authors</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-book text-success" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0 fw-bold">@Model.Sum(a => a.BooksCount)</h3>
                    <small class="text-muted">Total Books</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-person-check text-info" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0 fw-bold">@Model.Count(a => a.BooksCount > 0)</h3>
                    <small class="text-muted">Active Authors</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-person-plus text-warning" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0 fw-bold">@Model.Count(a => a.BooksCount == 0)</h3>
                    <small class="text-muted">New Authors</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Authors Grid -->
    <div class="row">
        @if (Model.Any())
        {
            @foreach (var author in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card author-card h-100 border-0 shadow-sm">
                        <!-- Author Actions (hover) -->
                        <div class="author-actions">
                            <button class="btn btn-sm btn-outline-primary" title="Edit Author" 
                                    onclick="openEditAuthorModal('@author.AuthorId')">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <a asp-action="Details" asp-route-id="@author.AuthorId" 
                               class="btn btn-sm btn-outline-info" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-warning" title="Archive Author" 
                                    onclick="openArchiveAuthorModal('@author.AuthorId')">
                                <i class="bi bi-archive"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" title="Delete Author" 
                                    onclick="openDeleteAuthorModal('@author.AuthorId')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                        <div class="card-body text-center">
                            <!-- Author Profile Image -->
                            <div class="author-avatar mb-3">
                                @if (!string.IsNullOrEmpty(author.ProfileImageUrl))
                                {
                                    <img src="@author.ProfileImageUrl" alt="@author.Name" 
                                         class="rounded-circle shadow-sm"
                                         style="width: 80px; height: 80px; object-fit: cover;"
                                         onerror="this.src='data:image/svg+xml;base64,'" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center shadow-sm"
                                         style="width: 80px; height: 80px;">
                                        <i class="bi bi-person text-muted" style="font-size: 2rem;"></i>
                                    </div>
                                }
                            </div>

                            <!-- Author Information -->
                            <h5 class="card-title fw-bold mb-2">@author.Name</h5>
                            
                            @if (author.BirthDate.HasValue)
                            {
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-calendar me-1"></i>
                                    Born @author.BirthDate.Value.ToString("MMMM dd, yyyy")
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(author.Biography))
                            {
                                <p class="text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @author.Biography
                                </p>
                            }

                            <!-- Books Count Badge -->
                            <div class="d-flex justify-content-center">
                                @if (author.BooksCount > 0)
                                {
                                    <span class="badge bg-primary px-3 py-2">
                                        <i class="bi bi-book me-1"></i>
                                        @author.BooksCount Book@(author.BooksCount > 1 ? "s" : "")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted px-3 py-2">
                                        <i class="bi bi-book me-1"></i>
                                        No Books Yet
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Footer with Quick Actions -->
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                <a asp-action="Details" asp-route-id="@author.AuthorId" 
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                                <button class="btn btn-outline-secondary btn-sm" 
                                        onclick="openEditAuthorModal('@author.AuthorId')">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Empty State -->
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="bi bi-people text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                    <h4 class="mt-3 text-muted">No Authors Found</h4>
                    <p class="text-muted">Start by adding your first author to the library system.</p>
                    <button class="btn btn-primary" onclick="openAddAuthorModal()">
                        <i class="bi bi-plus-circle me-2"></i>Add First Author
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Shared Modal for Author Operations -->
<div class="modal fade" id="authorModal" tabindex="-1" aria-labelledby="authorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Partial content will be loaded dynamically -->
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add Author Modal
        function openAddAuthorModal() {
            showLoadingModal('authorModal');
            fetch('/Author/AddModal')
                .then(response => response.text())
                .then(html => {
                    document.querySelector('#authorModal .modal-content').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('authorModal')).show();
                })
                .catch(error => {
                    showErrorAlert('Error loading Add Author modal: ' + error.message);
                });
        }

        // Edit Author Modal
        function openEditAuthorModal(authorId) {
            showLoadingModal('authorModal');
            fetch(`/Author/EditModal?id=${encodeURIComponent(authorId)}`)
                .then(response => response.text())
                .then(html => {
                    document.querySelector('#authorModal .modal-content').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('authorModal')).show();
                })
                .catch(error => {
                    showErrorAlert('Error loading Edit Author modal: ' + error.message);
                });
        }

        // Delete Author Modal
        function openDeleteAuthorModal(authorId) {
            showLoadingModal('authorModal');
            fetch(`/Author/DeleteModal?id=${encodeURIComponent(authorId)}`)
                .then(response => response.text())
                .then(html => {
                    document.querySelector('#authorModal .modal-content').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('authorModal')).show();
                })
                .catch(error => {
                    showErrorAlert('Error loading Delete Author modal: ' + error.message);
                });
        }

        // Archive Author Modal
        function openArchiveAuthorModal(authorId) {
            showLoadingModal('authorModal');
            fetch(`/Author/ArchiveModal?id=${encodeURIComponent(authorId)}`)
                .then(response => response.text())
                .then(html => {
                    document.querySelector('#authorModal .modal-content').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('authorModal')).show();
                })
                .catch(error => {
                    showErrorAlert('Error loading Archive Author modal: ' + error.message);
                });
        }

        // Handle form submissions
        document.addEventListener("submit", function (e) {
            const form = e.target;

            if (form.matches("#addAuthorForm") || form.matches("#editAuthorForm") || 
                form.matches("#deleteAuthorForm") || form.matches("#archiveAuthorForm")) {
                e.preventDefault();
                
                const submitBtn = form.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
                submitBtn.disabled = true;

                const formData = new FormData(form);
                fetch(form.action, {
                    method: form.method,
                    body: new URLSearchParams(formData)
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(text || 'Failed to submit form.');
                        });
                    }
                    
                    // Close modal and show success message
                    const modal = bootstrap.Modal.getInstance(document.getElementById('authorModal'));
                    modal.hide();
                    
                    showSuccessAlert('Operation completed successfully!');
                    
                    // Reload page after short delay
                    setTimeout(() => {
                        location.reload();
                    }, 1000);
                })
                .catch(error => {
                    showErrorAlert('Error: ' + error.message);
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                });
            }
        });

        // Utility Functions
        function showLoadingModal(modalId) {
            document.querySelector(`#${modalId} .modal-content`).innerHTML = `
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary mb-3"></div>
                    <p>Loading...</p>
                </div>
            `;
            new bootstrap.Modal(document.getElementById(modalId)).show();
        }

        function showSuccessAlert(message) {
            showAlert(message, 'success');
        }

        function showErrorAlert(message) {
            showAlert(message, 'danger');
        }

        function showAlert(message, type) {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show position-fixed" 
                     style="top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                    <i class="bi bi-${type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', alertHtml);
            
            // Auto dismiss after 4 seconds
            setTimeout(() => {
                const alert = document.querySelector('.alert:last-of-type');
                if (alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            }, 4000);
        }
    </script>
}

<style>
    /* Author Card Styles */
    .author-card {
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .author-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
    }

    .author-actions {
        position: absolute;
        top: 15px;
        right: 15px;
        display: flex;
        gap: 5px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 10;
    }

    .author-card:hover .author-actions {
        opacity: 1;
        pointer-events: auto;
    }

    .author-avatar img,
    .author-avatar div {
        transition: transform 0.3s ease;
    }

    .author-card:hover .author-avatar img,
    .author-card:hover .author-avatar div {
        transform: scale(1.1);
    }

    .badge {
        font-size: 0.85rem;
    }
</style>
